; Engine configuration for the native Android rebuild.
; Godot 4.6, no Unity license, no C# or externally hosted assets.
config_version=5

[application]
config/name="Jelly Bricks 3D"
config/icon="res://icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation=1
window/stretch/mode="canvas_items"

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.027, 0.035, 0.08, 1)
anti_aliasing/quality/msaa_3d=2
